<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- Bocal ne sauvegarde rien via les canaux système : c'est son propre rôle.
         Zéro backup cloud, zéro device-to-device transfer. -->
    <cloud-backup>
        <exclude domain="root" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
    </device-transfer>
</data-extraction-rules>
